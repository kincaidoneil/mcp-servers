{
  "name": "mcp-servers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm ui:build && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "ui:dev": "vite --config app/pare/_internal/ui/vite.config.mts",
    "ui:build": "vite build --config app/pare/_internal/ui/vite.config.mts",
    "test:e2e": "playwright test",
    "smoke:pare": "node scripts/pare-smoke.mts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@notionhq/client": "5.22.0",
    "jose": "6.2.3",
    "mcp-handler": "1.1.0",
    "motion": "13.2.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tldts": "^7.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^25.9.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "msw": "2.14.6",
    "oxfmt": "0.52.0",
    "oxlint": "1.67.0",
    "tailwindcss": "4.3.0",
    "typescript": "^5",
    "vite": "8.2.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.7"
  }
}
