# Apex URL of this MCP deployment, no path, no trailing slash. Every bridge
# (currently /notion, future /strava etc.) is served under this host. Each
# bridge appends its own path locally.
# Examples:
#   https://mcp.kincaidoneil.com
#   https://my-mcp-bridge.vercel.app
PUBLIC_BASE_URL=http://localhost:3000

# 32-byte secret for HMAC signing + AES-GCM key wrap of all OAuth artifacts.
# Generate with: openssl rand -base64 32
# Rotating this invalidates ALL outstanding tokens (your global revocation primitive).
JWT_SIGNING_KEY=

# ---- Notion bridge (/notion) ----

# Notion OAuth integration credentials (https://www.notion.so/profile/integrations)
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=

# Allowlist — at least one of these MUST be set, or the server refuses to start.
# Email is preferred (requires the Notion integration to have the
# "user information including email addresses" capability enabled).
ALLOWED_NOTION_EMAILS=
ALLOWED_NOTION_WORKSPACE_IDS=

# ---- Hevy bridge (/hevy) ----

# Allowlist of Hevy user ids permitted to connect (comma-separated, required).
# Users paste their own Hevy API key on the consent screen (Hevy web app →
# https://hevy.com/settings?developer, requires Hevy Pro). The bridge validates
# the key against GET /v1/user/info and checks the returned user id here.
# No server-side Hevy credentials are needed.
ALLOWED_HEVY_USER_IDS=

# ---- Pare (/pare) ----

# Who may connect, as comma-separated name:code pairs. The name owns the
# sessions created through that code; the code is what the user pastes on
# the consent screen. Generate a code with: openssl rand -hex 16
# Removing a pair revokes that user on their next tool call.
# Example: kincaid:4f9c...,guest:a1b2...
PARE_ACCESS_CODES=

# Session storage. Upstash Redis over REST, under either naming (the Vercel
# Marketplace Upstash integration sets the KV_REST_API_* pair). With neither
# pair set, sessions live in process memory and vanish on a cold start.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
