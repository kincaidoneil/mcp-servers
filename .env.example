# Apex URL of this MCP deployment, no path, no trailing slash. Every bridge
# (currently /notion, future /strava etc.) is served under this host. Each
# bridge appends its own path locally.
# Examples:
#   https://mcp.kincaidoneil.com
#   https://my-mcp-bridge.vercel.app
PUBLIC_BASE_URL=http://localhost:3000

# 32-byte secret for HMAC signing + AES-GCM key wrap of all OAuth artifacts.
# Generate with: openssl rand -base64 32
# Rotating this invalidates ALL outstanding tokens (your global revocation primitive).
JWT_SIGNING_KEY=

# ---- Notion bridge (/notion) ----

# Notion OAuth integration credentials (https://www.notion.so/profile/integrations)
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=

# Allowlist — at least one of these MUST be set, or the server refuses to start.
# Email is preferred (requires the Notion integration to have the
# "user information including email addresses" capability enabled).
ALLOWED_NOTION_EMAILS=
ALLOWED_NOTION_WORKSPACE_IDS=

# ---- Hevy bridge (/hevy) ----

# Allowlist of Hevy user ids permitted to connect (comma-separated, required).
# Users paste their own Hevy API key on the consent screen (Hevy web app →
# https://hevy.com/settings?developer, requires Hevy Pro). The bridge validates
# the key against GET /v1/user/info and checks the returned user id here.
# No server-side Hevy credentials are needed.
ALLOWED_HEVY_USER_IDS=

# ---- Workouts bridge (/workouts) ----
# One MCP server that publishes workout.completed events (MCP Events, as
# ChatGPT implements them) from Hevy and Intervals.icu, plus read tools.

# Allowlist of accounts, comma-separated hevyUserId:intervalsAthleteId pairs.
# Pairs, not two lists, so nobody can combine their own Hevy account with
# someone else's Intervals athlete. The athlete id works with or without its
# leading "i".
ALLOWED_WORKOUT_ACCOUNTS=

# Redis for subscriptions and the delivery outbox. The Vercel Marketplace
# Upstash integration injects KV_REST_API_URL/KV_REST_API_TOKEN; a direct
# Upstash database uses these names instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bearer secret for /workouts/tick, which polls Intervals and retries failed
# deliveries. Generate with: openssl rand -base64 32
WORKOUTS_TICK_SECRET=

# QStash calls /workouts/tick every five minutes (Vercel Hobby crons run only
# daily). Only scripts/workouts-schedule.mts reads these; the app does not.
QSTASH_TOKEN=
QSTASH_URL=

# Optional: an Intervals.icu OAuth app. With these set, the consent screen
# connects Intervals by OAuth instead of a pasted API key, which makes the
# athlete eligible for the app's webhooks. Set the app's redirect URI to
# <PUBLIC_BASE_URL>/workouts/oauth/intervals-callback.
INTERVALS_OAUTH_CLIENT_ID=
INTERVALS_OAUTH_CLIENT_SECRET=

# Optional: the secret configured on the Intervals app's webhook, whose URL is
# <PUBLIC_BASE_URL>/workouts/webhooks/intervals. Webhooks make delivery
# faster; the tick keeps polling as a backstop either way.
INTERVALS_WEBHOOK_SECRET=
